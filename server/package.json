    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "katex": "^0.16.22",
    "markdown-it": "^14.1.0",
    "multer": "^1.4.5-lts.1",
    "sanitize-html": "^2.17.0",
    "ua-parser-js": "^2.0.10"
  },
  "devDependencies": {
    "nodemon": "^3.1.10",
    "prisma": "^5.22.0"
  }
