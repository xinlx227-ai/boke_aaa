generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

enum ArticleStatus {
  DRAFT
  PENDING_REVIEW
  REJECTED
  PUBLISHED
  ARCHIVED
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id              Int              @id @default(autoincrement())
  username        String           @unique @db.VarChar(50)
  email           String           @unique @db.VarChar(100)
  passwordHash    String           @map("password_hash") @db.VarChar(255)
  phoneNumber     String?          @unique @map("phone_number") @db.VarChar(20)
  wechatBound     Boolean          @default(false) @map("wechat_bound")
  qqBound         Boolean          @default(false) @map("qq_bound")
  alipayBound     Boolean          @default(false) @map("alipay_bound")
  role            UserRole         @default(USER)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  articles        Article[]
  articleFavorites ArticleFavorite[]
  articleLikes    ArticleLike[]
  articleViews    ArticleView[]
  comments        Comment[]
  commentLikes    CommentLike[]
  editedVersions  ArticleVersion[] @relation("ArticleVersionEditor")
  reviewedArticles Article[]        @relation("ArticleReviewer")
  sessions        UserSession[]
  siteVisits      SiteVisit[]

  @@map("users")
}

model Article {
  id               Int              @id @default(autoincrement())
  authorId         Int              @map("author_id")
  categoryId       Int?             @map("category_id")
  title            String           @db.VarChar(200)
  slug             String           @unique @db.VarChar(220)
  contentMarkdown  String           @map("content_markdown") @db.LongText
  contentHtml      String           @map("content_html") @db.LongText
  chapterOrder     Int              @default(0) @map("chapter_order")
  status           ArticleStatus    @default(DRAFT)
  publishedAt      DateTime?        @map("published_at")
  submittedAt      DateTime?        @map("submitted_at")
  reviewedAt       DateTime?        @map("reviewed_at")
  reviewerId       Int?             @map("reviewer_id")
  reviewNote       String?          @map("review_note") @db.VarChar(500)
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  author           User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  category         Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  reviewer         User?            @relation("ArticleReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  comments         Comment[]
  favorites        ArticleFavorite[]
  images           ArticleImage[]
  likes            ArticleLike[]
  siteVisits       SiteVisit[]
  stats            ArticleStats?
  tags             ArticleTag[]
  versions         ArticleVersion[]
  views            ArticleView[]

  @@index([authorId])
  @@index([categoryId])
  @@index([reviewerId])
  @@index([status, publishedAt])
  @@map("articles")
}

model ArticleStats {
  articleId     Int      @id @map("article_id")
  viewCount     Int      @default(0) @map("view_count")
  likeCount     Int      @default(0) @map("like_count")
  favoriteCount Int      @default(0) @map("favorite_count")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  article       Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@map("article_stats")
}

model ArticleMetricEvent {
  id          Int      @id @default(autoincrement())
  articleId   Int      @map("article_id")
  userId      Int      @map("user_id")
  actorUserId Int?     @map("actor_user_id")
  metric      String   @db.VarChar(20)
  delta       Int
  occurredAt  DateTime @default(now()) @map("occurred_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId, metric, occurredAt])
  @@index([articleId, metric, occurredAt])
  @@map("article_metric_events")
}

model ArticleView {
  id        Int      @id @default(autoincrement())
  articleId Int      @map("article_id")
  userId    Int?     @map("user_id")
  visitorId String?  @map("visitor_id") @db.VarChar(100)
  viewedAt  DateTime @default(now()) @map("viewed_at")
  createdAt DateTime @default(now()) @map("created_at")
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([articleId, viewedAt])
  @@index([articleId, userId, viewedAt])
  @@index([articleId, visitorId, viewedAt])
  @@map("article_views")
}

model ArticleLike {
  articleId Int      @map("article_id")
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([articleId, userId])
  @@index([userId])
  @@map("article_likes")
}

model ArticleFavorite {
  articleId Int      @map("article_id")
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([articleId, userId])
  @@index([userId])
  @@map("article_favorites")
}

model SiteVisit {
  id        Int      @id @default(autoincrement())
  pageType  String   @map("page_type") @db.VarChar(20)
  articleId Int?     @map("article_id")
  userId    Int?     @map("user_id")
  visitorId String?  @map("visitor_id") @db.VarChar(100)
  visitedAt DateTime @default(now()) @map("visited_at")
  createdAt DateTime @default(now()) @map("created_at")
  article   Article? @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([visitedAt])
  @@index([pageType, visitedAt])
  @@index([pageType, articleId, userId, visitedAt])
  @@index([pageType, articleId, visitorId, visitedAt])
  @@map("site_visits")
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique @db.VarChar(80)
  slug      String    @unique @db.VarChar(100)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  articles  Article[]

  @@map("categories")
}

model Tag {
  id        Int          @id @default(autoincrement())
  name      String       @unique @db.VarChar(80)
  slug      String       @unique @db.VarChar(100)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  articles  ArticleTag[]

  @@map("tags")
}

model ArticleTag {
  articleId Int      @map("article_id")
  tagId     Int      @map("tag_id")
  createdAt DateTime @default(now()) @map("created_at")
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
  @@map("article_tags")
}

model ArticleImage {
  id         Int      @id @default(autoincrement())
  articleId  Int      @map("article_id")
  imageUrl   String   @map("image_url") @db.VarChar(255)
  altText    String?  @map("alt_text") @db.VarChar(255)
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  article    Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, sortOrder])
  @@map("article_images")
}

model Comment {
  id         Int           @id @default(autoincrement())
  articleId  Int           @map("article_id")
  userId     Int           @map("user_id")
  parentId   Int?          @map("parent_id")
  replyToCommentId Int?     @map("reply_to_comment_id")
  content    String        @db.Text
  status     CommentStatus @default(APPROVED)
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")
  article    Article       @relation(fields: [articleId], references: [id], onDelete: Cascade)
  likes      CommentLike[]
  parent     Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies    Comment[]     @relation("CommentReplies")
  replyTo    Comment?      @relation("CommentReplyTargets", fields: [replyToCommentId], references: [id], onDelete: SetNull)
  targetedReplies Comment[] @relation("CommentReplyTargets")
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([articleId, status, createdAt])
  @@index([parentId])
  @@index([replyToCommentId])
  @@index([userId])
  @@map("comments")
}

model CommentLike {
  commentId Int      @map("comment_id")
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@index([userId])
  @@map("comment_likes")
}

model UserSession {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  deviceId     String   @map("device_id") @db.VarChar(191)
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  userAgent    String?  @map("user_agent") @db.VarChar(500)
  tokenHash    String   @unique @map("token_hash") @db.VarChar(255)
  lastActiveAt DateTime @default(now()) @map("last_active_at")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, deviceId])
  @@index([userId, isActive, lastActiveAt])
  @@map("user_sessions")
}

model ArticleVersion {
  id               Int           @id @default(autoincrement())
  articleId        Int           @map("article_id")
  editorId         Int?          @map("editor_id")
  versionNumber    Int           @map("version_number")
  title            String        @db.VarChar(200)
  slug             String        @db.VarChar(220)
  contentMarkdown  String        @map("content_markdown") @db.LongText
  contentHtml      String        @map("content_html") @db.LongText
  chapterOrder     Int           @default(0) @map("chapter_order")
  status           ArticleStatus @default(DRAFT)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  article          Article       @relation(fields: [articleId], references: [id], onDelete: Cascade)
  editor           User?         @relation("ArticleVersionEditor", fields: [editorId], references: [id], onDelete: SetNull)

  @@unique([articleId, versionNumber])
  @@index([editorId])
  @@map("article_versions")
}
